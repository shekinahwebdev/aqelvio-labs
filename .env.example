# Public site origin used for metadata, sitemap, and Open Graph URLs.
# Leave unset for local development (defaults to http://localhost:3000).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Project enquiries (contact form) — server-side only; never prefix with NEXT_PUBLIC_.
# Delivered through Resend (https://resend.com). Put real values in .env.local.
#
# API key from your Resend account (Dashboard → API Keys), "Sending access".
RESEND_API_KEY=
# Inbox that receives enquiries. Until the agency domain is verified in Resend,
# this must be the email address your Resend account is registered with.
ENQUIRY_TO_EMAIL=
# Sender. Leave unset to use Resend's test sender (onboarding@resend.dev), which
# only delivers to the Resend account's own address. After verifying the agency
# domain in Resend, set e.g.: Aqelvio Labs <enquiries@your-domain>
ENQUIRY_FROM_EMAIL=
